<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <ComponentGroup Id="CleanupComponents">
            <!-- Clean up the main installation directory -->
            <Component Id="CleanupInstallDir" Guid="77b1f5bc-c792-4232-99bd-5f94a18df128" Directory="INSTALLDIR">
                <CreateFolder />
                <!-- Remove the entire directory tree on uninstall -->
                <!-- This is more efficient than enumerating individual files -->
                <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\WingetWebInterface" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </ComponentGroup>
        
        <!-- Custom action to force cleanup if standard removal fails -->
        <CustomAction Id="ForceCleanup" 
                      Directory="INSTALLDIR" 
                      Execute="deferred" 
                      ExeCommand="cmd.exe /c &quot;timeout /t 2 /nobreak &gt;nul &amp;&amp; if exist &quot;[INSTALLDIR]&quot; rd /s /q &quot;[INSTALLDIR]&quot;&quot;"
                      Return="ignore"
                      Impersonate="no" />
        
        <InstallExecuteSequence>
            <!-- Run cleanup after files are removed, ignore errors to prevent hang -->
            <Custom Action="ForceCleanup" After="RemoveFiles">REMOVE="ALL"</Custom>
        </InstallExecuteSequence>
    </Fragment>
</Wix>
