<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <ComponentGroup Id="CleanupComponents">
            <!-- Clean up the main installation directory -->
            <Component Id="CleanupInstallDir" Guid="77b1f5bc-c792-4232-99bd-5f94a18df128" Directory="INSTALLDIR">
                <CreateFolder />
                <!-- Remove all files in the directory on uninstall -->
                <RemoveFile Id="RemoveAllFiles" Name="*.*" On="uninstall" />
                <!-- Remove any subdirectories and their contents -->
                <RemoveFile Id="RemoveSubdirFiles" Name="*.*" On="uninstall" Directory="INSTALLDIR" />
                <!-- Remove the main folder after files are cleaned -->
                <RemoveFolder Id="CleanupInstallDir" On="uninstall" />
            </Component>
            
            <!-- Clean up WebView2 cache if present -->
            <Component Id="CleanupWebView2Cache" Guid="a8c1b2d3-e4f5-6a7b-8c9d-0e1f2a3b4c5d" Directory="INSTALLDIR">
                <CreateFolder />
                <RemoveFile Id="RemoveWebView2Files" Name="*.*" On="uninstall" />
                <RemoveFolder Id="CleanupEBWebView" On="uninstall" />
            </Component>
        </ComponentGroup>
    </Fragment>
</Wix>
