{
  "productName": "winget-web-interface",
  "version": "1.5.0",
  "identifier": "com.winget.web",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinGet Web Interface",
        "width": 1600,
        "height": 900,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:11434 https://api.github.com https://generativelanguage.googleapis.com https://api.openai.com; img-src 'self' asset: https://asset.localhost https://avatars.githubusercontent.com data: blob:; font-src 'self' data:; media-src 'self' data: blob:; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "fragmentPaths": [
          "./wix/cleanup.wxs"
        ],
        "componentGroupRefs": [
          "CleanupComponents"
        ]
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "^https?://.*"
    }
  }
}