{
    "$schema": "../gen/schemas/desktop-capability.json",
    "identifier": "default",
    "description": "Default permissions for the app",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:path:default",
        "core:event:default",
        "core:window:default",
        "core:app:default",
        "core:resources:default",
        "core:menu:default",
        "core:tray:default",
        "shell:allow-open",
        {
            "identifier": "shell:allow-execute",
            "allow": [
                {
                    "name": "winget",
                    "cmd": "winget",
                    "args": true
                },
                {
                    "name": "choco",
                    "cmd": "choco",
                    "args": true
                },
                {
                    "name": "scoop",
                    "cmd": "scoop",
                    "args": true
                },
                {
                    "name": "brew",
                    "cmd": "brew",
                    "args": true
                },
                {
                    "name": "apt",
                    "cmd": "apt",
                    "args": true
                },
                {
                    "name": "git",
                    "cmd": "git",
                    "args": true
                },
                {
                    "name": "powershell",
                    "cmd": "powershell",
                    "args": true
                }
            ]
        },
        "dialog:default",
        "dialog:allow-confirm",
        "dialog:allow-ask",
        "dialog:allow-open",
        "dialog:allow-save",
        "fs:default",
        "process:default"
    ]
}